<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Timo Club | Unlimited</title>

<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;800;900&display=swap" rel="stylesheet">

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Cairo',sans-serif;
}

body{
background:#070712;
color:white;
overflow-x:hidden;
}


:root{
--main:#8b5cf6;
--second:#2563eb;
--gold:#fbbf24;
}


.container{
width:90%;
max-width:1200px;
margin:auto;
}


header{

position:fixed;
top:0;
width:100%;
z-index:99;

background:rgba(0,0,0,.35);
backdrop-filter:blur(15px);

padding:15px 0;

}


.nav{

display:flex;
justify-content:space-between;
align-items:center;

}


.logo{

font-size:28px;
font-weight:900;

background:linear-gradient(90deg,#a855f7,#38bdf8);

-webkit-background-clip:text;
color:transparent;

}


.stats{

display:flex;
gap:20px;
font-size:14px;

}


.stat{

background:#ffffff12;
padding:8px 15px;
border-radius:20px;

}



.hero{

min-height:100vh;

display:flex;
align-items:center;
justify-content:center;

text-align:center;

background:

radial-gradient(circle at top,#6d28d9,transparent 35%),
radial-gradient(circle at bottom,#2563eb,transparent 35%);

}



.box{

background:#ffffff12;

border:1px solid #ffffff22;

backdrop-filter:blur(20px);

border-radius:30px;

padding:40px;

max-width:550px;

animation:show 1s;

}


@keyframes show{

from{
opacity:0;
transform:translateY(50px);
}

to{
opacity:1;
transform:none;
}

}



.logo-big{

width:120px;
height:120px;

margin:auto;

border-radius:35px;

display:flex;
align-items:center;
justify-content:center;

font-size:55px;
font-weight:900;

background:
linear-gradient(135deg,var(--main),var(--second));

box-shadow:
0 0 50px #8b5cf6;

}



h1{

margin:25px 0 10px;

font-size:35px;

}


p{

color:#ddd;
line-height:1.8;

}



.buttons{

display:flex;
gap:15px;

margin-top:30px;

}



button{

border:0;
padding:15px 25px;

border-radius:15px;

cursor:pointer;

font-size:17px;

font-weight:bold;

transition:.3s;

flex:1;

}



button:hover{

transform:translateY(-5px);

}



.yes{

background:var(--main);
color:white;

}


.no{

background:white;
color:black;

}



.discount{

margin-top:20px;

display:none;

background:#16a34a;

padding:15px;

border-radius:15px;

}



section{

padding:100px 0;

}



.title{

text-align:center;

font-size:35px;

margin-bottom:40px;

}



.cards{

display:grid;

grid-template-columns:repeat(auto-fit,minmax(250px,1fr));

gap:25px;

}



.card{

background:#ffffff10;

border:1px solid #ffffff20;

padding:30px;

border-radius:25px;

transition:.4s;

}



.card:hover{

transform:translateY(-10px);

box-shadow:0 20px 50px #0008;

}



.price{

font-size:30px;

font-weight:900;

color:#38bdf8;

}


.badge{

display:inline-block;

background:#f59e0b;

padding:5px 12px;

border-radius:20px;

font-size:13px;

}



.features li{

list-style:none;

margin:10px 0;

}



.warning{

background:#7c2d12;

padding:15px;

border-radius:15px;

margin-top:20px;

}



@media(max-width:600px){

.stats{

display:none;

}


h1{

font-size:25px;

}


.buttons{

flex-direction:column;

}

}

</style>

</head>


<body>


<header>

<div class="container nav">


<div class="logo">
Timo Club
</div>


<div class="stats">


<div class="stat">
👥 الزيارات:
<span id="visits">
34123
</span>
</div>


<div class="stat">
🟢 الآن:
<span id="online">
300
</span>
</div>


</div>


</div>

</header>



<main>


<div class="hero">


<div class="box">


<div class="logo-big">
T
</div>


<h1>
أهلاً بك في Timo Club ✨
</h1>


<p>
طور تجربتك داخل مجتمع Timo Club
<br>
هل هذه أول مرة تستخدم الموقع؟
</p>



<div class="buttons">


<button class="yes" onclick="firstVisit()">
نعم - خصم 10%
</button>


<button class="no" onclick="goPlans()">
لا
</button>


</div>


<div class="discount" id="discount">
🎉 تم تفعيل خصم 10% على الاشتراكات
</div>



</div>


</div>


<section id="plans">

<div class="container">

<h2 class="title">
اشتراكات Unlimited
</h2>


<div class="cards">


<div class="card">

<h3>شهر</h3>

<div class="price">
865
</div>

<button onclick="selectPlan('شهر')">
اختيار
</button>

</div>



<div class="card">

<h3>شهرين</h3>

<div class="price">
1450
</div>

<button onclick="selectPlan('شهرين')">
اختيار
</button>

</div>


<div class="card">

<h3>3 شهور</h3>

<div class="price">
2050
</div>

<button onclick="selectPlan('3 شهور')">
اختيار
</button>

</div>


<div class="card">

<h3>5 شهور</h3>

<div class="price">
2500
</div>

<button onclick="selectPlan('5 شهور')">
اختيار
</button>

</div>


<div class="card">

<span class="badge">
استرداد 50%
</span>

<h3>6 شهور</h3>

<div class="price">
3650
</div>

<button onclick="selectPlan('6 شهور')">
اختيار
</button>

</div>


<div class="card">

<span class="badge">
استرداد 70%
</span>

<h3>12 شهر</h3>

<div class="price">
6895
</div>

<button onclick="selectPlan('12 شهر')">
اختيار
</button>

</div>


</div>

</div>

</section>   <section id="details">

<div class="container">

<h2 class="title">
تفاصيل اشتراك Unlimited
</h2>


<div class="card">

<h2 id="selected">
اختر اشتراكك أولاً
</h2>


<ul class="features">

<li>✅ مكالمات فيديو طوال فترة الاشتراك</li>

<li>✅ مكالمات صوتية طوال فترة الاشتراك</li>

<li>✅ إرسال واستقبال الرسائل طوال مدة الاشتراك</li>

<li>✅ جميع الخدمات المتاحة خلال فترة الاشتراك</li>

</ul>


<div class="warning">

⚠️ تنبيه:
<br>
اشتراك Unlimited لا يشمل إرسال الهدايا.

</div>


<br>

<button onclick="payment()">
الانتقال للدفع
</button>


</div>

</div>

</section>




<section id="pay">

<div class="container">


<h2 class="title">
طريقة الدفع
</h2>


<div class="card">


<h3>
ملخص الطلب
</h3>


<p id="summary">
لم يتم اختيار اشتراك
</p>


<hr>


<h3>
اختر طريقة الدفع
</h3>


<select id="method">

<option>
اختر طريقة الدفع
</option>

<option>
Vodafone Cash
</option>

<option>
InstaPay
</option>

<option>
تحويل بنكي
</option>


</select>


<br><br>


<div class="warning">

بعد تفعيل اشتراك 6 شهور أو 12 شهر،
يتم استرداد 70% من قيمة الاشتراك
على نفس طريقة الدفع المستخدمة.

</div>


<br>


<button onclick="confirmOrder()">
تأكيد الطلب
</button>


</div>


</div>

</section>




<section>

<div class="container">


<h2 class="title">
السياسات
</h2>


<div class="card">


<h3>
سياسة الاستخدام
</h3>

<p>
يستخدم الاشتراك خلال المدة المحددة فقط،
ولا يمكن مشاركة الاشتراك مع مستخدم آخر.
</p>


<hr>


<h3>
سياسة الاسترجاع
</h3>

<p>
يتم تطبيق استرداد 70% فقط على اشتراكات
6 شهور و12 شهر بعد التفعيل حسب الشروط المحددة.
</p>


<hr>


<h3>
الخصوصية
</h3>

<p>
نحافظ على بيانات المستخدمين ونستخدمها فقط
لتقديم الخدمة وتحسين تجربة الاستخدام.
</p>


</div>


</div>

</section>




</main>






<script>


let plan="";


// نظام أول زيارة

function firstVisit(){

localStorage.setItem(
"timo_discount",
"true"
);


document.getElementById("discount").style.display="block";


setTimeout(()=>{

document
.getElementById("plans")
.scrollIntoView({
behavior:"smooth"
});


},1500);


}



function goPlans(){

document
.getElementById("plans")
.scrollIntoView({
behavior:"smooth"
});

}



// اختيار الاشتراك

function selectPlan(name){

plan=name;


document.getElementById("selected").innerHTML=
"اشتراك Unlimited - "+name;


document
.getElementById("details")
.scrollIntoView({
behavior:"smooth"
});


}




function payment(){


if(plan===""){

alert("اختر الاشتراك أولاً");

return;

}



document.getElementById("summary").innerHTML=

"الاشتراك المختار: Unlimited "+plan+
"<br>سيتم حساب السعر حسب الباقة المختارة";


document
.getElementById("pay")
.scrollIntoView({
behavior:"smooth"
});


}





function confirmOrder(){

let method=
document.getElementById("method").value;


if(method.includes("اختر")){

alert("اختر طريقة الدفع");

return;

}


alert(
"تم تسجيل طلبك بنجاح\nسيتم متابعة الدفع عبر "+method
);


}




// عداد الزيارات

let visits =
localStorage.getItem("timo_visits");


if(!visits){

visits=34123;

}


visits++;


if(visits>34781){

visits=34781;

}


localStorage.setItem(
"timo_visits",
visits
);


document.getElementById("visits")
.innerHTML =
Number(visits).toLocaleString();





// الزوار الآن

function randomOnline(){

let num =
Math.floor(
Math.random()*(623-184)+184
);


document.getElementById("online")
.innerHTML=num;


}


setInterval(
randomOnline,
4000
);


randomOnline();



</script>


</body>
</html>
